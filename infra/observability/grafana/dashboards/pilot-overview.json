      "targets": [{ "expr": "up{job=\"fairhire-api\"}", "refId": "A" }],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Required dependencies ready",
      "targets": [{ "expr": "sum(fairhire_dependency_ready)", "refId": "A" }],
