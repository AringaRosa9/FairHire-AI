    },
    {
      "type": "timeseries",
      "title": "HTTP request rate by status",
      "targets": [
        {
          "expr": "sum by (status) (rate(fairhire_http_requests_total[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "API latency percentiles",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fairhire_http_request_duration_seconds_bucket[5m])))",
