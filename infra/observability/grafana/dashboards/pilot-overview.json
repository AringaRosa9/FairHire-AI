          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(fairhire_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P50",
          "refId": "B"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
